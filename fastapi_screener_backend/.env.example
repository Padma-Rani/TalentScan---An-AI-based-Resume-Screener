# Application Settings
APP_NAME=AI Resume Screener & Semantic Job Matching Engine
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Local AI Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Semantic Matching Thresholds (0.0 - 1.0)
SEMANTIC_MATCH_THRESHOLD=0.70
STRONG_MATCH_THRESHOLD=0.82
RELATED_MATCH_THRESHOLD=0.65
WEAK_MATCH_THRESHOLD=0.50

# Decision Engine Thresholds (0.0 - 100.0)
SHORTLIST_THRESHOLD=80.0
MANUAL_REVIEW_THRESHOLD=60.0

# Scoring Component Weights (Must sum to 1.0)
WEIGHT_SEMANTIC_MATCH=0.40
WEIGHT_EVIDENCE_STRENGTH=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_PREFERRED_SKILLS=0.10
WEIGHT_EXACT_KEYWORD=0.05
